# =============================================================================
# Iyanuoluwa Digital Operations - environment variables
# Copy to `.env` (git-ignored) and fill in real values. `.env.example` is safe
# to commit; never commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (OPTIONAL - the app has a full localStorage / in-memory fallback)
# Exposed to the browser (VITE_ prefix). Anon key only, never the service key.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# -----------------------------------------------------------------------------
# AI Operations Intelligence proxy  (/api/ai Vercel serverless function)
# -----------------------------------------------------------------------------

# SERVER-ONLY secrets. Set these in the Vercel project (Environment Variables),
# NOT with a VITE_ prefix - they must never reach the browser bundle.

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Anthropic Claude API key. Either name works; ANTHROPIC_API_KEY wins if both set.
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_API_KEY=your-anthropic-api-key

# Shared-secret bearer token that the /api/ai proxy requires on every request
# (Authorization: Bearer <token>). Generate a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The SAME value must be set as VITE_AI_PROXY_TOKEN below so the client can send it.
AI_PROXY_TOKEN=generate-a-long-random-secret

# Comma-separated CORS allowlist for the /api/ai proxy. Only these origins get an
# Access-Control-Allow-Origin header echoed back. No spaces needed; no wildcard.
AI_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# CLIENT copy of the proxy token (VITE_ prefix => bundled into the browser app).
# Must equal AI_PROXY_TOKEN. If unset, the app shows an "AI proxy not configured"
# error instead of calling /api/ai.
# NOTE: because this ships in the client bundle it is not truly secret - it is a
# throttle/attribution token, not a hard access control. Rotate it if leaked, and
# rely on AI_ALLOWED_ORIGINS + the per-IP rate limit as the real perimeter.
VITE_AI_PROXY_TOKEN=generate-a-long-random-secret

# --- Supabase (schema) ---
# Used ONLY to apply the SQL under supabase/ (migrations + seed) with the
# Supabase CLI or psql. SERVER-SIDE / developer machine only - never VITE_ prefixed,
# never committed in a real .env. Get it from:
#   Supabase Dashboard > Project Settings > Database > Connection string (URI)
# Local dev stack (`supabase start`) default:
#   postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
